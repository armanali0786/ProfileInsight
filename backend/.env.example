PORT=5000
MONGODB_URI=mongodb://localhost:27017/profileinsight

# Must match the `authtoken` header value the extension sends (src/config.js -> AuthData.token)
STATIC_AUTH_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9.eyJ1c2VyIjoiZGV2IiwibmFtZSI6IiIsIkFQSV9USU1FIjoxNzMyMzM2NTY3fQ.Dr8ZaBGhXfBqoQQecV2G-Kv-pENc7hN6ISdDDrdYe_Y

# LinkedIn app used by the LIVE login flow (src/config.js -> LinkedInApi.clientId = 78n452xoqjxjwk)
# This is a DIFFERENT LinkedIn app than the one referenced in SocialLogin.tsx (dead code).
LINKEDIN_CLIENT_ID=78n452xoqjxjwk
LINKEDIN_CLIENT_SECRET=replace-with-real-secret
LINKEDIN_REDIRECT_URI=https://<your-extension-id>.chromiumapp.org/linkedin-callback

# Used by src/utils/groq.js to parse a LinkedIn profile top-card HTML fragment into
# structured fields (name/headline/location/profile_image) for POST /admin/api/profile/sync.
GROQ_API_KEY=replace-with-real-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
